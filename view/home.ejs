<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener Dashboard</title>
    <style>
        :root {
            --primary: #007BFF;
            --primary-hover: #0056b3;
            --background: #f8f9fa;
            --surface: #ffffff;
            --text: #212529;
            --text-secondary: #6c757d;
            --border: #dee2e6;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--background);
            color: var(--text);
            margin: 0;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .container {
            width: 100%;
            max-width: 900px;
            background: var(--surface);
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }

        h1 {
            margin-top: 0;
            font-size: 28px;
            color: #1a1a1a;
            border-bottom: 2px solid var(--background);
            padding-bottom: 10px;
        }

        .form-group {
            margin: 25px 0;
        }

        form {
            display: flex;
            gap: 10px;
            width: 100%;
        }

        input[type="text"] {
            flex: 1;
            padding: 12px 16px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: var(--primary);
        }

        button {
            padding: 12px 24px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
        }

        button:hover {
            background: var(--primary-hover);
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .table-container {
            overflow-x: auto;
            margin-top: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th, td {
            padding: 14px;
            border-bottom: 1px solid var(--border);
        }

        th {
            background-color: #f1f3f5;
            color: var(--text-secondary);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 12px;
            letter-spacing: 0.5px;
        }

        tr:hover {
            background-color: #f8f9fa;
        }

        .short-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .short-link:hover {
            text-decoration: underline;
        }

        .long-link {
            color: var(--text-secondary);
            max-width: 300px;
            display: inline-block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            vertical-align: middle;
        }

        .badge {
            background: #e9ecef;
            color: #495057;
            padding: 4px 8px;
            border-radius: 4px;
            font-weight: bold;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔗 URL Shortener</h1>

        <% if (locals.id) { %>
            <div class="alert-success">
                🎉 Success! Your Short link is: 
                <a class="short-link" href="http://localhost:8000/api/url/<%= id %>" target="_blank">
                    http://localhost:8000/api/url/<%= id %>
                </a>
            </div>
        <% } %>

        <div class="form-group">
            <form action="/api/url" method="POST">
                <input type="text" name="url" placeholder="Paste your long original URL here (e.g., https://example.com)" required>
                <button type="submit">Generate</button>
            </form>
        </div>

        <div class="table-container">
            <h3>Active Links & Click Logs</h3>
            
            <% if (locals.urls && urls.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Short ID Link</th>
                            <th>Original Destination URL</th>
                            <th>Click Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% urls.forEach((urlEntry, index) => { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                    <a class="short-link" href="http://localhost:8000/api/url/<%= urlEntry.ShortId %>" target="_blank">
                                        <%= urlEntry.ShortId %>
                                    </a>
                                </td>
                                <td>
                                    <a class="long-link" href="<%= urlEntry.RedirectUrl %>" target="_blank" title="<%= urlEntry.RedirectUrl %>">
                                        <%= urlEntry.RedirectUrl %>
                                    </a>
                                </td>
                                <td>
                                    <span class="badge">
                                        <%= urlEntry.VisitHistory ? urlEntry.VisitHistory.length : 0 %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: var(--text-secondary); font-style: italic;">No short URLs generated yet. Use the input bar above to make your first link!</p>
            <% } %>
        </div>
    </div>
</body>
</html>
